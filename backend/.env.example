ENVIRONMENT=development
DEBUG=true

# Postgres — asyncpg driver required
DATABASE_URL=postgresql+asyncpg://gateway_user:gateway_pass@db:5432/gateway_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Credential encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change_me_generate_a_fernet_key

CORS_ORIGINS=http://localhost:5173
